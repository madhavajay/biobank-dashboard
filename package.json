{
	"name": "bipmed-biobank",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --host localhost",
		"cf:dev": "wrangler dev",
		"deploy": "bun run build && wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:seed": "bun scripts/seed-db.ts --local",
		"db:seed:local": "bun scripts/seed-db.ts --local",
		"db:seed:remote": "bun scripts/seed-db.ts --remote",
		"db:refresh-stats:remote": "bun scripts/refresh-explore-stats-remote.ts --apply",
		"db:verify-stats:remote": "bun scripts/refresh-explore-stats-remote.ts --verify-only",
		"db:export:vcf": "bun scripts/export-vcf.ts",
		"db:export:loci-filter": "bun scripts/export-loci-filter.ts",
		"db:import:1kgp": "bun scripts/import-1kgp-superpop-af.ts",
		"prepare": "svelte-kit sync || echo ''",
	"test": "bun test src/lib/search/variant-search.test.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260410.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.8.0",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "^7.2.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"bits-ui": "^2.16.3",
		"drizzle-kit": "^0.31.10",
		"layerchart": "2.0.0-next.48",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.0.7",
		"wrangler": "^4.11.1"
	},
	"dependencies": {
		"bun": "^1.3.12",
		"clsx": "^2.1.1",
		"dev": "^0.1.3",
		"drizzle-orm": "^0.45.2",
		"mapbox-gl": "^3.24.1",
		"tailwind-merge": "^3.5.0"
	}
