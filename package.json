{
	"name": "bipmed-biobank",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --host localhost",
		"cf:dev": "wrangler dev",
		"deploy": "bun run build && wrangler deploy",
		"deploy:preview": "bun run build && wrangler deploy --env preview",
		"db:pg:seed": "bun scripts/seed-postgres.ts",
		"db:pg:refresh-metadata": "bun scripts/refresh-dataset-metadata-postgres.ts",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test src/lib/search/variant-search.test.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260410.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.8.0",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "^7.2.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/pg": "^8.20.0",
		"bits-ui": "^2.16.3",
		"layerchart": "2.0.0-next.48",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.0.7",
		"wrangler": "^4.11.1"
	},
	"dependencies": {
		"bun": "^1.3.12",
		"clsx": "^2.1.1",
		"dev": "^0.1.3",
		"mapbox-gl": "^3.24.1",
		"pg": "^8.21.0",
		"tailwind-merge": "^3.5.0"
	}
}
